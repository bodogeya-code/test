    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Noto Sans JP', sans-serif; background-color: #0f172a; color: #f1f5f9; }
        .article-content p { margin-bottom: 1.5rem; line-height: 1.8; color: #cbd5e1; }
        .article-content h2 { font-size: 1.5rem; font-weight: 900; color: #fbbf24; margin-top: 3rem; margin-bottom: 1.5rem; border-left: 5px solid #fbbf24; padding-left: 1rem; }
        .article-content h3 { font-size: 1.25rem; font-weight: 900; color: #fde68a; margin-top: 2rem; margin-bottom: 1rem; }
